# Optional overrides for /etc/fvc/fvcd.env.
FVC_HOME=/var/lib/fvc
FVC_RUNTIME_DIR=/run/fvc
FVC_GRPC_NETWORK=unix
FVC_GRPC_ADDR=/run/fvc/fvcd.sock
FVC_RUNTIME_GROUP=fvc
FVC_RUNTIME_INIT_PATH=/usr/bin/fvc-init
FVC_RUNTIME_ROOT_DEVICE=/dev/vda
FVC_GUEST_AGENT_MODE=vsock
FVC_FIRECRACKER_PATH=/usr/bin/firecracker
FVC_IMAGE_BASE_URL=https://fvchubstorage.blob.core.windows.net/images
FVC_NETWORK_ENABLED=true
FVC_STRICT_RUNTIME_CHECKS=true
